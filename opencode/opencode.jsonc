{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "chat": {
      "mode": "primary",
      "prompt": "You are a conversational coding assistant. Answer questions directly and concisely. Do NOT explore the codebase, read files, or create plans unless explicitly asked. For trivial questions, just answer. Keep responses short and conversational.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "deny",
        "grep": "deny",
        "glob": "deny",
        "list": "deny",
        "task": "deny",
      },
      "temperature": 0.3,
    },
  },
  "lsp": {
    "basedpyright": {
      "disabled": false,
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "diagnosticMode": "workspace",
      },
    },
  },
  "disabled_providers": ["opencode"],
  "provider": {
    "paratera": {
      "name": "Paratera",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llmapi.paratera.com",
      },
      "models": {
        "DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
        },
        "GLM-5.3": {
          "name": "GLM 5.3",
        },
        "Qwen3.8-Max": {
          "name": "Qwen 3.8 Max",
        },
        "Kimi-K3": {
          "name": "Kimi K3",
        },
        "GLM-4-Flash": {
          "name": "GLM 4 Flash (free)",
        },
        "GLM-4-FlashX": {
          "name": "GLM 4 FlashX",
        },
        "DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash",
        },
        "GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash",
        },
      },
    },
  },
}
