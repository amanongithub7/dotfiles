{
  "$schema": "https://opencode.ai/config.json",
  "model": "paratera/DeepSeek-V4.1-Flash",

  // Search integration for the websearch tool.
  // Needs TAVILY_API_KEY in the environment, or sign in with /connect in the TUI.
  // Free tier: 1,000 credits/month, no credit card (1 credit = 1 basic search).
  "websearch": {
    "provider": "tavily",
  },

  // Skill sources: each entry is a directory OpenCode scans for SKILL.md files.
  // Sources from every config file are combined, not replaced.
  "skills": [
    "~/.opencode-skills/nature-skills/skills",
    "~/.opencode-skills/anthropic-skills/skills",
  ],

  // Superpowers is a plugin, not a skills directory: it registers its own skills.
  // Requires OpenCode >= 2.0.4. Remove this line to uninstall.
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],

  // Global rules run first; agent rules are appended after them, so agents can
  // re-allow what this denies. The academic-writing pack is only useful to the
  // paper agent, so keep it out of every other agent's prompt.
  //
  // To restore V1 behavior of prompting before touching paths outside the
  // project, add: { "action": "external_directory", "resource": "*", "effect": "ask" }
  "permissions": [{ "action": "skill", "resource": "nature-*", "effect": "deny" }],

  // Hard denials that no agent rule or saved "Allow always" approval can lift,
  // and that a cloned repo cannot re-enable: policies are evaluated from the
  // broadest config last. `provider.use` is the V2 replacement for the V1
  // `disabled_providers` list.
  //
  // Do NOT move the nature-* skill denial in here. The paper agent re-allows it,
  // and a policy can only be lifted by broader config, never by an agent rule.
  //
  // OpenCode 2.0.25 reads these from `experimental.policies`; the top-level
  // `policies` key in the published docs postdates this build. On 2.0.25 the
  // `experimental` schema is exactly { portable_shell_scanner, subagent_depth,
  // policies } — there is no `todo`, so the todowrite tool the docs describe is
  // not available until OpenCode is upgraded past 2.0.25.
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" },
      { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
      { "action": "tool.use", "resource": "edit:*/.ssh/*", "effect": "deny" },
      { "action": "tool.use", "resource": "read:*/.gnupg/*", "effect": "deny" },
      { "action": "tool.use", "resource": "edit:*/.gnupg/*", "effect": "deny" },
      { "action": "tool.use", "resource": "read:*/.aws/credentials", "effect": "deny" },
    ],
  },

  // Format files after the write/edit/patch tools change them. A built-in only
  // runs when its executable is present, so today this is gofmt and rustfmt:
  // ruff is not installed and uv 0.5.9 predates `uv format`. For Python, switch
  // to the object form and add, for example:
  //   "formatter": { "ruff": { "command": ["uvx", "ruff", "format", "$FILE"],
  //                            "extensions": [".py", ".pyi"] } }
  // The built-in prettier also covers .md, but it only runs inside a project
  // that depends on prettier, so the Zotero notes are not at risk.
  "formatter": true,

  // Named directories outside the project, advertised to agents by description.
  // References grant no permissions: reads and edits still go through the read,
  // edit and external_directory rules.
  "references": {
    "vault": {
      "path": "~/vaults/climate-crisis",
      "description": "Research vault. Literature notes are research-papers-🔬/notes/<citekey>.md; the paper agent owns this workflow.",
    },
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "Personal dotfiles: this OpenCode config, nvim, zsh, tmux.",
    },
  },

  "agents": {
    // Plain conversational assistant: no filesystem, no skills, no subagents.
    // steps bounds the tool loop: after that many tool-using steps OpenCode
    // removes the tools and forces a plain-text answer. Verified behavior:
    // 2 = two searches then a clean answer; 3 = three searches, more sourced.
    // Do NOT use 1: tools are removed before the first action, and the
    // injected "maximum steps reached" notice made the model hallucinate.
    "chat": {
      "mode": "primary",
      "description": "Conversational assistant with web search. No file access, no skills.",
      "model": "paratera/DeepSeek-V4.1-Flash#chat",
      "steps": 2,
      "system": "Answer questions directly and concisely. Search the web only when the answer needs current or verifiable information; otherwise answer from your own knowledge. Reply in plain prose and cite source links when you searched. Do not explore the filesystem, load skills, or write plans. For questions about papers, references, or literature notes, tell the user to switch to the paper agent.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
      ],
    },
  },

  "lsp": {
    "basedpyright": {
      "disabled": false,
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "diagnosticMode": "workspace",
      },
    },
  },

  // The `opencode` provider is denied under `policies` above; this replaces the
  // V1 `disabled_providers` list.

  "providers": {
    "paratera": {
      "name": "Paratera",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://llmapi.paratera.com",
      },
      "models": {
        "DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
        },
        "GLM-5.3": {
          "name": "GLM 5.3",
        },
        "Qwen3.8-Max": {
          "name": "Qwen 3.8 Max",
        },
        "Kimi-K3": {
          "name": "Kimi K3",
        },
        "GLM-4-Flash": {
          "name": "GLM 4 Flash (free)",
        },
        "GLM-4-FlashX": {
          "name": "GLM 4 FlashX",
        },
        // Variants are the only way to set per-agent request options in V2:
        // an agent pins the model as provider/model#variant. Agent-level
        // temperature is accepted but never sent, so the #chat variant above
        // is what actually applies temperature 0.3.
        "DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash",
          "variants": [{ "id": "chat", "body": { "temperature": 0.3 } }],
        },
        "GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash",
        },
      },
    },
  },
}
