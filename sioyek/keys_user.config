# ============================================================================
#  sioyek — user keybindings
#
#  macOS modifiers:  <D-..> = Cmd    <C-..> = Ctrl    <A-..> = Option
#  Multi-key sequences are written without separators, e.g. `gnh` = g, n, h.
#  After editing, run `:` and then `reload` (or just restart sioyek).
#
#  Full command / key reference:
#  https://sioyek-documentation.readthedocs.io/en/latest/configuration.html#keys
# ============================================================================

# ---------------------------------------------------------------------------
#  Cmd-based shortcuts for everyday actions (macOS-native muscle memory)
# ---------------------------------------------------------------------------
overview                <D-f>
search                  <D-S-f>
next_page               <D-right>
previous_page           <D-left>      # was `prev_page` -> not a real command (silent no-op)
zoom_in                 <D-equals>
zoom_out                <D-minus>
fit_to_page_width       <D-9>
fit_to_page_height      <D-0>         # fill the screen vertically (good for wide screens)
copy                    <D-c>
close_window            <D-w>
toggle_fullscreen       <D-return>
# moved off plain `d` so `db` / `dh` / `dp` no longer have to wait for a timeout
toggle_dark_mode        <D-d>

# ---------------------------------------------------------------------------
#  vim-style scrolling
#  No visual mark needed. <C-d>/<C-u> move half a screen
#  (the fraction is `move_screen_ratio` in prefs_user.config).
# ---------------------------------------------------------------------------
screen_down             <C-d>         # half page down  (vim <C-d>)
screen_up               <C-u>         # half page up    (vim <C-u>)
move_down               <C-j>         # small step down (vim <C-e>)
move_up                 <C-k>         # small step up   (vim <C-y>)
move_down               <C-e>
move_up                 <C-y>
next_page               <C-n>
previous_page           <C-p>

# ---------------------------------------------------------------------------
#  highlights
#    add    : select text with the mouse -> `h` -> colour letter (a-z)
#    delete : hover the highlight        -> `x`
# ---------------------------------------------------------------------------
delete_highlight_under_cursor   x
delete_highlight                dh    # works on the highlight you clicked on
edit_selected_highlight         <D-e> # edit the highlight's note/annotation
add_annot_to_selected_highlight <D-S-e>
goto_next_highlight             gnh
goto_prev_highlight             gNh
# pick a persistent colour once, then highlight later selections in one keystroke
set_select_highlight_type       <D-s>
add_highlight_with_current_type <D-S-s>
toggle_select_highlight         <D-a> # every mouse selection is auto-highlighted

# ---------------------------------------------------------------------------
#  navigation / misc quality-of-life
# ---------------------------------------------------------------------------
goto_page_with_page_number      <D-g>
goto_toc                        <D-t>
next_chapter                    <D-S-right>
prev_chapter                    <D-S-left>
toggle_highlight                <D-l>    # show/hide clickable PDF links
enter_visual_mark_mode          <D-m>
close_visual_mark               <esc>
keyboard_smart_jump             <D-j>
