# === QUALITY OF LIFE (paired with keys_user.config) === #

# Fraction of the screen that screen_down/screen_up move.
# 0.5 makes <C-d>/<C-u> behave like vim's half-page scroll.
move_screen_ratio 0.5

# We deliberately rebind built-in keys in keys_user.config; don't warn about it.
should_warn_about_user_key_override 0

# Zoom toward the mouse cursor instead of the centre of the screen.
wheel_zoom_on_cursor 1

# Faster search index for large PDFs.
super_fast_search 1
