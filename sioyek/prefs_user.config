# Colours are deliberately left at sioyek's built-in defaults.
# A Catppuccin Latte (light) / Mocha (dark) palette used to live here; it is in
# git history if you ever want the themed version back.

# === STARTUP: don't resurrect the previously-opened document === #
# By default sioyek reopens the last document when it starts with no file
# argument. On macOS a double-clicked/`open`ed PDF arrives as an Apple Event a
# moment *after* startup, so you got the old PDF first and the one you asked for
# in a second window (upstream issue #1488).
#
# `open_last_file_on_startup 0` is the official fix, but it only exists on
# sioyek's development branch - the Homebrew cask 2.0.0 build silently ignores
# it. Keeping it here so it takes effect the moment a newer build is used.
# (The commit that added it called it `open_last_document_on_startup`; the
# name actually registered by sioyek is the one below.)
open_last_file_on_startup 0

# Needed alongside it: with the restore off, 2.0 falls back to the bundled
# tutorial PDF (a newer build would too), which again leaves a stray first
# window. 0 = open nothing instead. Bare `sioyek` gives an empty window.
should_load_tutorial_when_no_other_file 0

# Do NOT set should_launch_new_window 0. It hides the resurrected document by
# making the PDF you open take over the startup window, but it also means every
# later PDF replaces the one you already have open - no side-by-side reading.
# Stock behaviour (1) is what we want: works once the restore above is off.
# Until then the restore is disabled at the source instead, by making sioyek's
# session file unusable - see "session file" in this directory's README.
should_launch_new_window 1

# === QUALITY OF LIFE (paired with keys_user.config) === #

# Fraction of the screen that screen_down/screen_up move.
# 0.5 makes <C-d>/<C-u> behave like vim's half-page scroll.
move_screen_ratio 0.5

# We deliberately rebind built-in keys in keys_user.config; don't warn about it.
should_warn_about_user_key_override 0

# Zoom toward the mouse cursor instead of the centre of the screen.
wheel_zoom_on_cursor 1

# Faster search index for large PDFs.
super_fast_search 1
