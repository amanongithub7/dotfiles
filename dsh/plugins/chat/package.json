{
  "name": "@aman/dsh-chat",
  "version": "2.9.0",
  "private": true,
  "description": "A chat client for Harness: one direct provider call per message, with file attachments and Tavily grounding, and no agent loop",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "store.js",
    "ground.js",
    "host-smoke.mjs",
    "client-smoke.mjs",
    "UPGRADE.md",
    "contract/sidebar-workspaces.md",
    "contract/sidebar-workspaces.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": "^0.2.1-rc.5"
  }
}
